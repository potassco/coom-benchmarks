product {
    num         0-500	maxPrice
	num			0-500	requestedVolume
    0..* Bike		bikes
}

structure Bike {
    num		0-100	price
	Wheel			frontWheel
	Wheel			rearWheel
	Frame			frame
	Carrier			carrier
}

structure Carrier { 0..3 Bag bag }
structure Frame   {	0..2 Bag bag }

enumeration Bag {
	attribute num 	volume
    attribute num	price

	B5  = ( 5 3 )
	B10 = ( 10 6 )
	B25 = ( 25 8 )
	B50 = ( 50 12 )
}

enumeration Wheel {
	attribute	num	 size
    attribute   num  price

	W22	= (	 22	5 )
	W24	= (	 24	10 )
	W26	= (	 26	20 )
	W28	= (	 28	25 )
}


behavior {
    require sum(bikes.price) <= maxPrice

	require requestedVolume <= sum(bikes.frame.bag.volume) + sum(bikes.carrier.bag.volume)
}

behavior Bike {
    require count(carrier.bag) + count(frame.bag) <= 2

    require frontWheel.size = rearWheel.size

    imply price = frontWheel.price + rearWheel.price + sum(carrier.bag.price) + sum(frame.bag.price)
}
