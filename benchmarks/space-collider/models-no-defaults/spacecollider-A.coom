}

behavior NoseHair_Trimmer_Auto_Scent {
	// @explanation = explanation_7658
	require root.Ship_Dog_Compact_Height.Reading_Lamp_Aux_Position.NoseHair_Trimmer_Auto_Scent.A_Makeup_Mirror_Compact_Color != A_Solar_Orange
}

behavior NoseHair_Trimmer_Auto_Scent {
	// @explanation = explanation_22106
