behavior Reading_Lamp_Auto_Sound {
	// @explanation = explanation_30525
	require root.Ship_Dog_Compact_Height.Cookie_Oven_Primary_Material.Reading_Lamp_Auto_Sound.A_Makeup_Mirror_Shared_Height != A_90cm
}

behavior Reading_Lamp_Aux_Color {
	// @explanation = explanation_13310
	require root.Ship_Dog_Compact_Height.Cookie_Oven_Primary_Material.Reading_Lamp_Aux_Color.A_NoseHair_Trimmer_Luxury_Level != A_Medium
}

behavior Reading_Lamp_Aux_Height {
	// @explanation = explanation_16398
	require root.Ship_Dog_Compact_Height.Cookie_Oven_Primary_Material.Reading_Lamp_Aux_Height.A_Gravity_Field_Shared_Depth != A_40cm
}

behavior NoseHair_Trimmer_Auto_Scent {
	// @explanation = explanation_24178
	require root.Ship_Dog_Compact_Height.Reading_Lamp_Aux_Position.NoseHair_Trimmer_Auto_Scent.A_Adventure_Pool_Luxury_Width != A_55cm
}

behavior NoseHair_Trimmer_Auto_Scent {
	// @explanation = explanation_12618
	require root.Ship_Dog_Compact_Height.Reading_Lamp_Aux_Position.NoseHair_Trimmer_Auto_Scent.A_Gravity_Field_Compact_Level != A_Moderate
}

behavior NoseHair_Trimmer_Auto_Scent {
