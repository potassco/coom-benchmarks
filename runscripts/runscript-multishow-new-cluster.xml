<runscript output="output">

	<machine name="cluster" cpu="24x8xE5520@2.27GHz" memory="24GB"/>

	<config name="coom-seq" template="templates/coom-seq.sh"/>
	<config name="coom-seq-unbounded" template="templates/coom-seq-unbounded.sh"/>

	<system name="coomsuite" version="1.2.0" measures="clasp" config="coom-seq" cmdline="-q">
		<setting name="multishot-linear"			cmdline="--solver clingo --bounds=linear 	 --multishot" 	tag="incremental linear multi" 			dist_template="templates/coom.dist">
					<variable cmd="--step {}" value="1;2;3;4;6;8;12;16;24;32" />
					<variable cmd="--grounding {}" value="stepwise;jump-extend;jump-full" />
		</setting>
		<setting name="multishot-exponential"  		cmdline="--solver clingo --bounds=exponential --multishot" 	tag="incremental exponential multi" 	dist_template="templates/coom.dist">
					<variable cmd="--base {}" value="1.25;1.33;1.5;1.66;1.75;2;2.25;2.33;2.5;2.66;2.75" />
					<variable cmd="--grounding {}" value="stepwise;jump-extend;jump-full" />
		</setting>
		<setting name="multishot-linear-fix-externals"			cmdline="--solver clingo --bounds=linear 	 --multishot --fix-externals" 	tag="incremental linear multi" 			dist_template="templates/coom.dist">
					<variable cmd="--step {}" value="1;2;3;4;6;8;12;16;24;32" />
					<variable cmd="--grounding {}" value="stepwise;jump-extend;jump-full" />
		</setting>
		<setting name="multishot-exponential-fix-externals"  		cmdline="--solver clingo --bounds=exponential --multishot --fix-externals" 	tag="incremental exponential multi" 	dist_template="templates/coom.dist">
					<variable cmd="--base {}" value="1.25;1.33;1.5;1.66;1.75;2;2.25;2.33;2.5;2.66;2.75" />
					<variable cmd="--grounding {}" value="stepwise;jump-extend;jump-full" />
		</setting>
    </system>

	<distjob name="dist-gen" timeout="600s" runs="1" script_mode="timeout" walltime="12h 00m 00s" cpt="4"/>

	<benchmark name="base">
		<!-- <folder path="benchmarks/city-bike-fleet/instances">
		</folder> -->
		<folder path="benchmarks/travel-bike-fleet/instances">
		</folder>
		<folder path="benchmarks/restaurant/instances">
		</folder>
	</benchmark>

	<benchmark name="unbounded-only">
		<!-- <folder path="benchmarks/cargo-bike/instances">
		</folder> -->
		<folder path="benchmarks/cargo-bike-nested/instances">
		</folder>
	</benchmark>

	<project name="coom-benchmarks-incremental" job="dist-gen">
		<runtag machine="cluster" benchmark="base" 				tag="multi"/>
		<runtag machine="cluster" benchmark="unbounded-only"	tag="multi"/>
	</project>
</runscript>

